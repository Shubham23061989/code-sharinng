# Copy to .env.local and adjust.

# true  = use built-in mock data (no backend needed)
# false = call the real backend
VITE_USE_MOCK=true

# Base path / URL for all API calls.
# Keep "/api" in dev (Vite proxies it), or set a full URL e.g. https://cx-api.example.com/api
VITE_API_BASE_URL=/api

# Where Vite's dev proxy forwards /api requests
VITE_PROXY_TARGET=http://localhost:8000

# Simulated network delay for mock data (ms)
VITE_MOCK_DELAY_MS=500
